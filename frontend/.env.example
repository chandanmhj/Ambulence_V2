# Copy this to .env.local for local overrides, or set these as actual
# environment variables in your Vercel/Netlify project settings for deployment.
# Not needed for local `npm run dev` against a local backend - it falls back
# to http://localhost:8000 automatically.

VITE_BACKEND_HTTP=https://your-backend.up.railway.app
VITE_BACKEND_WS=wss://your-backend.up.railway.app
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
